{
  "manifest_version": 3,
  "name": "Kannaadi - Tamil to English letters",
  "short_name": "Kannaadi",
  "version": "1.2.0",
  "description": "Select Tamil text, tap the glass icon (or press Alt+Shift+T) and read it in English letters, right on top of the text.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Kannaadi",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["storage", "contextMenus", "sidePanel"],
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/engine/transliterate.js", "src/content/content.js"],
      "css": ["src/content/page.css"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/ui.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "transliterate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "MacCtrl+Shift+T"
      },
      "description": "Transliterate the selected Tamil text"
    }
  }
}
